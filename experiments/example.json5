{
  // Reproducibility
  // You can use one seed or multiple seeds:
  seed: 123,
  // seed: [123, 456, 789],

  // Main loop
  n_steps: 4000,
  // Receiver sampling
  receivers_per_step: {
    min_count: 10,
    max_count: 20,
  },
  // or fixed number of receivers per step
  // receivers_per_step: 15,

  // Candidate seller sampling
  candidates: {
    min_count: 3,
    max_count: 5,
  },
  // or fixed number of candidates
  // candidates: 4,

  // Seller selection
  // "softmax" or "argmax"
  // Beta is only used for softmax
  selection: {
    mode: "softmax",
    // mode: "argmax",
    theta: 0.2,
    beta: 2.0,
  },

  // normalization mode of local trust values
  // positive: [0, 1]
  // negative: [-1, 1]
  normalization: {
    mode: "positive", 
  },

  // Price model
  price: {
    mu: 0.0,
    sigma: 0.6,
  },

  // Decay parameter
  decay: {
    lambda: 1.02,
  },

  // Global trust aggregations
  global_trust: {
    modes: [
      "mean",
      {mode: "shape", tau: "None"},
      {mode: "eigen", alpha: 0.15, percentage: 0.2},
    ],
  },

  // Typed peer specs. 'kind' must match a class from tms_sim/peers.py
  peers: [
    {
      kind: "HonestNormalPeer",
      count: 10,
    },
    {
      kind: "HonestSupremePeer",
      count: 5,
    },
    {
      kind: "MaliciousBasicPeer",
      count: 5,
      params: {
        type: "bad_rater", // "honest", "inverse", or "bad_rater"
      },
    },
    {
      kind: "MaliciousRaterPeer",
      count: 5,
    },
    {
      kind: "TargetingMaliciousRaterPeer",
      count: 5,
      params: {
        target_seller_ids: "range(0,15)", // range of seller IDs to target - all honest peers
      },
    },
    {
      kind: "FreeRiderPeer",
      count: 5,
    },
    {
      kind: "FreeRiderBuyerPeer",
      count: 5,
    },
    {
      kind: "TraitorPeer",
      count: 5,
      params: {
        betrayal_gap: 9, // Number of honest transactions before betrayal
        periodic: true, // Betrays every betrayal_gap transactions
      },
    },
    {
      kind: "TraitorPeer",
      count: 5,
      params: {
        periodic: false, // Betrays on big transactions
      },
    },
    {
      kind: "CollusiveBasicPeer",
      count: 5,
      params: {
        colluder_ids: "range(50, 60)", // all colluders (basic + targeting)
        quality: false, // optional (default: false)
      },
    },
    {
      kind: "CollusiveTargetingPeer",
      count: 5,
      params: {
        colluder_ids: "range(50, 60)", // all colluders (basic + targeting)
        target_seller_ids: "range(0, 15)", // all honest peers
        quality: false,  // optional (default: false)
      },
    },
    {
      kind: "SybilAccountPeer",
      count: 5,
      params: {
        main_account_id: 15, // first malicious peer
      },
    },
  ],
}
